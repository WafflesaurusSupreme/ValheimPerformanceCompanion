<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap desktop6 rescap">
  <Identity Name="ValidationOnly" Publisher="CN=ValidationOnly" Version="0.1.11.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Valheim Performance Companion</DisplayName>
    <PublisherDisplayName>WafflesaurusSupreme</PublisherDisplayName>
    <Description>Valheim performance recording, system profiling and offline diagnostics.</Description>
    <Logo>StoreAssets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies><TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" /></Dependencies>
  <Resources><Resource Language="en-us" /></Resources>
  <Applications>
    <Application Id="Companion" Executable="ValheimPerformanceCompanionLauncher.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Valheim Performance Companion" Description="Valheim performance recording and diagnostics"
                          Square150x150Logo="StoreAssets\Square150x150Logo.png" Square44x44Logo="StoreAssets\Square44x44Logo.png" BackgroundColor="transparent" />
      <Extensions>
        <desktop6:Extension Category="windows.service" Executable="VpcCollectorService.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop6:Service Name="ValheimPerformanceCompanionCollector" StartupType="auto" StartAccount="localSystem" />
        </desktop6:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="packagedServices" />
    <rescap:Capability Name="localSystemServices" />
  </Capabilities>
</Package>
